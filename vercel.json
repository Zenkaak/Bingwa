{
  "buildCommand": "pnpm --filter @workspace/bingwa run build",
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "artifacts/bingwa/dist/public",
  "rewrites": [
    {
      "destination": "/api/index.ts",
      "source": "/api/:path*"
    },
    {
      "destination": "/index.html",
      "source": "/(.*)"
    }
  ],
  "version": 2
}
